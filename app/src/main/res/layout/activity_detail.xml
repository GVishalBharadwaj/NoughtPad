<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        tools:context=".DetailActivity">

        <!-- Expense Amount Header (Visible only when Mark as Expense is active) -->
        <LinearLayout
            android:id="@+id/amount_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMOUNT"
                android:letterSpacing="0.1"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSurface"
                android:alpha="0.6"/>

            <EditText
                android:id="@+id/edit_text_amount_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="₹0"
                android:textColorHint="@color/md_theme_surfaceVariant"
                android:inputType="numberDecimal"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minWidth="120dp"/>
        </LinearLayout>

        <!-- Main Content Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/md_theme_surface"
            app:cardCornerRadius="24dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title Input -->
                <EditText
                    android:id="@+id/edit_text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="What is this?"
                    android:textColorHint="@color/colorTextSecondary"
                    android:inputType="textCapSentences"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:background="@android:color/transparent"
                    android:minHeight="48dp" />

                <!-- Description Input -->
                <EditText
                    android:id="@+id/edit_text_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Add details..."
                    android:textColorHint="@color/colorTextSecondary"
                    android:textColor="@color/md_theme_onSurface"
                    android:inputType="textCapSentences|textMultiLine"
                    android:background="@android:color/transparent"
                    android:minHeight="80dp"
                    android:gravity="top"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_surfaceVariant"
                    android:layout_marginVertical="16dp"
                    android:alpha="0.5"/>

                <!-- Folder / Tag Section (Replaces Category Dropdown) -->
                <LinearLayout
                    android:id="@+id/folder_section_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/folder_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOLDER / TAG"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurface"
                        android:alpha="0.5"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/folder_chip_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">
                            <!-- Chips will be added dynamically -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_folder_personal"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personal" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_folder_work"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Work" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_folder_finance"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Finance" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_add_folder"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+ New"
                                app:chipIcon="@android:drawable/ic_input_add"/>
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Reminder Date Section (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/reminder_details_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/dark_card_bg"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_clock"
                        app:tint="@color/md_theme_primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/text_view_selected_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Sep 01, 2025 at 11:14 PM"
                        android:textColor="@color/md_theme_primary"
                        android:textStyle="bold"/>
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                        
                    <ImageView
                         android:id="@+id/btn_clear_reminder"
                         android:layout_width="24dp"
                         android:layout_height="24dp"
                         android:src="@android:drawable/ic_menu_close_clear_cancel"
                         app:tint="@color/colorTextSecondary"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_set_reminder"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set Reminder"
                    app:chipIcon="@drawable/ic_clock"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mark_expense"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark as Expense"
                    app:chipIcon="@drawable/ic_wallet"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Expense Date Options (Hidden until Expense mode) -->
        <LinearLayout
            android:id="@+id/expense_date_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textSize="11sp"
                android:textColor="@color/md_theme_onSurface"
                android:alpha="0.5"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/expense_date_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_detail_today"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_detail_yesterday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yesterday"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_detail_custom_date"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom..."/>
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/button_delete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textColor="@color/colorExpense"
                app:strokeColor="@color/colorExpense"
                android:visibility="gone"
                tools:visibility="visible"/>

            <!-- Hidden AI Button for now as requested by user to keep UI clean, but kept in layout -->
            <Button
                android:id="@+id/button_smart_analyze"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="AI Scan"
                android:visibility="gone"/>

            <Button
                android:id="@+id/button_save"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Save"
                android:textColor="@color/md_theme_onPrimary"
                android:backgroundTint="@color/md_theme_primary"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
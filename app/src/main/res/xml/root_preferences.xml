<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="Sharing">
        <SwitchPreferenceCompat
            app:key="custom_title_toggle"
            app:title="Set Custom Title"
            app:summary="Show a dialog to set a custom title for shared items before processing." />
    </PreferenceCategory>
    <PreferenceCategory app:title="Notifications">
        <ListPreference
            app:key="reminder_offset"
            app:title="Remind me"
            app:summary="%s"
            app:defaultValue="0"
            app:entries="@array/reminder_offset_labels"
            app:entryValues="@array/reminder_offset_values" />
    </PreferenceCategory>
</PreferenceScreen>